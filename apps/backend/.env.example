NODE_ENV=development
PORT=4000

SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

JWT_SECRET=your_long_random_secret
JWT_EXPIRES_IN=8h

CORS_ORIGIN=http://127.0.0.1:5500
FRONTEND_URL=http://127.0.0.1:5500
PAYMENT_PROVIDER_CALLBACK_SECRET=replace-with-a-random-secret-of-at-least-24-characters

# Optional authorised national examination-results provider.
# Leave blank to use institutional manual verification.
NATIONAL_RESULTS_PROVIDER_URL=
NATIONAL_RESULTS_PROVIDER_API_KEY=
